APP_NAME=AI DevOps Engineer Assistant
APP_ENV=development
LOG_LEVEL=INFO

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_HISTORY_MESSAGES=12

# Execution remains disabled.
COMMAND_EXECUTION_ENABLED=false
REQUIRE_COMMAND_APPROVAL=true
COMMAND_TIMEOUT_SECONDS=30

# Future documentation retrieval
DOCUMENTS_DIR=data/docs
VECTOR_INDEX_DIR=data/indexes

# Phase 4: Knowledge Base / RAG
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25
RAG_MAX_DOCUMENT_MB=10
RAG_MAX_FILES=200
RAG_MAX_CONTEXT_CHARS=18000
# Observability: local Prometheus/Grafana stack
PROMETHEUS_METRICS_ENABLED=false
PROMETHEUS_METRICS_PORT=8000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
